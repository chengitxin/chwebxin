generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户：role = ADMIN | EDITOR | USER
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
}

// 栏目（对应原 Topic）
model Topic {
  id        Int       @id @default(autoincrement())
  text      String
  dateAdded DateTime  @default(now())
  // 修改日期（2026-10-15）：后台"栏目管理"显示并按此倒序排列。
  // 故意不挂 @updatedAt 自动刷新——导航位置重排（reorderNav）会批量更新所有可见栏目的
  // navOrder，若自动刷新会把整列修改日期刷成同一时刻、列表顺序失效；
  // 改为在 updateTopicAction 保存栏目表单时显式写入 updatedAt。
  updatedAt DateTime  @default(now())
  entries   Entry[]
  sections  Section[]

  // 前台导航栏配置（2026-10-07）：navVisible=false 时导航栏隐藏该栏目；
  // navOrder 数值越小越靠前，同为 0 时按创建时间排序（后台"栏目管理"里配置）
  navVisible Boolean @default(true)
  navOrder   Int     @default(0)
  // 导航链接地址：非空时该记录为"导航链接"（如 /music、/video），导航栏直接跳转该地址，
  // 不作为内容栏目参与新闻绑定、首页版块、统计等场景
  navUrl     String?

  @@index([dateAdded])
}

// 新闻条目（对应原 Entry：txbt→title，text 保留富文本 HTML）
model Entry {
  id         Int      @id @default(autoincrement())
  topicId    Int
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title      String
  text       String
  image      String?
  dateAdded  DateTime @default(now()) @updatedAt
  clickCount Int      @default(0)

  // 首页头条（独立「头条管理」页维护，见 /admin/headline）：
  // isHeadline=是否上头条；headlineOrder=轮播顺序（升序，越小越靠前）；
  // startAt/expireAt 为可空的上下架时间窗口，前台只取窗口内生效的稿件
  isHeadline       Boolean   @default(false)
  headlineOrder    Int       @default(0)
  headlineStartAt  DateTime?
  headlineExpireAt DateTime?

  @@index([topicId, dateAdded])
  @@index([dateAdded])
  @@index([image])
}

// 站点配置（单例，id=1）：后台可全量配置前台展示
model Config {
  id                   Int     @id @default(1)
  siteTitle            String  @default("新闻网站内容发布管理系统")
  siteSubtitle         String  @default("News website content publishing management system")
  logoImage            String  @default("") // 自定义徽标（留空=前台回退内置的 6 张主题徽标）
  showLogoImage        Boolean @default(true) // 是否在页头显示徽标图片
  showSiteTitle        Boolean @default(true) // 是否在页头显示站点标题（中文大标题）
  showSiteSubtitle     Boolean @default(true) // 是否在页头显示副标题（英文）
  showSearch           Boolean @default(true)
  showHeadline         Boolean @default(true)
  showHero             Boolean @default(true) // 是否显示首页大图轮播
  showTabsPanel        Boolean @default(true) // 是否显示首页大图轮播右侧标签页
  // 导航栏背景是否整行填充主题色（关闭=白底导航，文字改为深灰、当前栏目用浅主题色胶囊）
  navFullBg            Boolean @default(true)
  // 导航栏样式（可选值见 src/lib/nav-styles.ts，新增样式时追加，勿改动已有 value）
  navStyle             String  @default("bar")
  heroInterval         Int     @default(5) // 首页大图轮播间隔（秒）
  adInterval           Int     @default(4) // 广告轮播间隔（秒）
  footerLine1          String  @default("汉中市南郑区人民政府主办 | 南郑区数据服务中心管理维护 | 网站运维电话：0916-5512459")
  footerLine2          String  @default("陕ICP备12002362号-1　网站标识码：6107210005　　陕公网安备 61072102000146号 汉公网备61230067")
  topicPerPage         Int     @default(3) // 栏目页每页条数
  searchPerPage        Int     @default(3) // 搜索页每页条数
  headlineCount        Int     @default(1) // 首页头条条数
  // 首页头条轮播间隔（秒）：头条改为「头条管理」页手动指定稿件，前台逐条自动轮播
  headlineInterval     Int     @default(5)
  // 头条切换效果：复用首页大图/广告轮播的效果选项（CarouselEffect），非法值回退 fade
  headlineEffect       String  @default("fade")
  carouselEffect       String  @default("flip3d") // 首页大图切换效果：fade=淡入淡出 | kenburns=慢推放大 | flip3d=3D翻转（见 Carousel.tsx effect 属性）
  adCarouselEffect     String  @default("fade") // 广告轮播切换效果：取值同 carouselEffect
  adminEntryPerPage    Int     @default(15) // 后台内容管理每页条数
  musicPerPage         Int     @default(20) // 音乐每页条数（前台 /music 与后台音乐管理共用）
  videoPerPage         Int     @default(20) // 视频每页条数（前台 /video 与后台视频管理共用）
  episodePerPage       Int     @default(20) // 后台分集管理每页条数
  siteTheme            String  @default("classic-blue") // 整站风格主题（对应 globals.css 的 data-theme 预设，见 src/lib/themes.ts）
  siteBrowserTitle     String  @default("新闻网站内容发布管理系统") // 前台浏览器标签页文字
  adminBrowserTitle    String  @default("管理后台") // 后台浏览器标签页文字
  // 删除/更换内容时是否同步清理零引用的上传文件（新闻封面与正文、站点徽标、音乐库、视频库共用）。
  // 关闭后只删/改数据库记录，磁盘文件保留为孤儿文件（可事后用脚本统一比对清理）
  cleanupFilesOnDelete Boolean @default(true)
  // 视频聚合采集接口（/api/provide/vod）的访问 KEY：留空=接口关闭；填写后聚合站凭此 KEY 采集
  vodApiKey            String  @default("")
}

// 首页版块：slot = headline | tab | hero | card | photo_card | ad
model Section {
  id        Int     @id @default(autoincrement())
  key       String  @unique
  title     String
  topicId   Int?
  topic     Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  slot      String
  listCount Int     @default(6)
  order     Int     @default(0)
  isActive  Boolean @default(true)

  // 全宽广告位位置（仅 slot=ad 生效）：
  // top=卡片区上方；after:<版块 key>=紧接该版块之后（后台下拉从现有版块生成）
  adPosition String @default("top")

  // 卡片显示样式（仅 slot=card 生效，用于文本卡片与图文卡片互相切换）：
  // text=普通文本列表（默认），photo=图文卡样式（顶部图片轮播+下方列表）
  displayStyle String @default("text")

  // 图文卡顶部图片轮播张数（仅图文卡生效：card 且 displayStyle=photo，或历史 photo_card slot）：
  // 与 listCount 独立——listCount 控制下方文字列表条数，imageCount 控制顶部图片轮播张数
  imageCount Int @default(10)

  // 大图轮播排除栏目（仅 slot=hero 且未绑定栏目时生效）：逗号分隔的栏目 ID。
  // 取全站有图新闻时跳过这些栏目，未勾选的栏目全部进入轮播；留空=不排除任何栏目
  excludeTopicIds String @default("")
}

// 音乐库：前台 /music 页播放列表的数据源，后台 /admin/music 管理；
// albumId 非空时表示该音乐是某张专辑的一首曲目，trackNo 为曲目号
model Music {
  id           Int      @id @default(autoincrement())
  title        String // 歌曲名
  artist       String   @default("") // 歌手
  src          String // 音频文件 URL（/uploads/music/xxx.mp3）
  cover        String? // 封面图 URL（可空）
  fileSize     Float? // 文件大小（字节），上传/补录时写入
  duration     Float? // 时长（秒），上传时由浏览器读取写入；扫描补录的无法读取为空
  originalName String? // 上传时的原始文件名
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  albumId      Int? // 所属专辑（空=独立单曲）
  album        Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackNo      Int      @default(1) // 曲目号（独立单曲恒为 1）
  trackTitle   String   @default("") // 曲目内标题（可空，空则显示"第 N 首"）
  description  String   @default("") // 单曲简介（独立单曲播放时展示；镜像 Video.description）

  @@unique([albumId, trackNo])
  @@index([order])
}

// 专辑库：一张专辑的元数据，曲目存放在 Music（albumId 关联），镜像 Series/Video 的结构
model Album {
  id          Int      @id @default(autoincrement())
  title       String // 专辑名
  cover       String? // 封面图 URL（可空）
  artist      String   @default("") // 专辑歌手
  year        Int? // 年份
  description String   @default("") // 简介
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  // 修改时间：新增/编辑曲目、编辑专辑信息时显式更新（镜像 Series.updatedAt 语义），供后台排序
  updatedAt   DateTime @default(now())
  musics      Music[]

  @@index([order])
  @@index([updatedAt])
}

// 剧集库：一部电视剧/影片的元数据，分集存放在 Video（seriesId 关联）
model Series {
  id            Int      @id @default(autoincrement())
  title         String // 剧名
  cover         String? // 封面图 URL（可空）
  description   String   @default("") // 简介
  category      String   @default("电视剧") // 分类（与 src/lib/series.ts 的 SERIES_CATEGORIES 对应）
  year          Int? // 年份
  area          String   @default("") // 地区
  status        String   @default("ongoing") // ongoing=连载中 | completed=已完结
  totalEpisodes Int? // 计划总集数（可空，空则按实际分集数）
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  // 修改时间：新增/编辑分集、编辑剧集信息时显式更新，供采集接口做更新时间与后台排序
  updatedAt     DateTime @default(now())
  videos        Video[]

  @@index([order])
  @@index([updatedAt])
}

// 视频库：前台 /video 页播放列表的数据源，后台 /admin/video 管理；
// seriesId 非空时表示该视频是某部剧集的一集，episodeNo 为集号
model Video {
  id           Int      @id @default(autoincrement())
  title        String // 视频标题
  src          String // 视频文件 URL（/uploads/medias/xxx.mp4）
  poster       String? // 封面图 URL（可空，视频加载前显示）
  fileSize     Float? // 文件大小（字节），上传/补录时写入
  duration     Float? // 时长（秒），上传时由浏览器读取写入；扫描补录的无法读取为空
  originalName String? // 上传时的原始文件名
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  seriesId     Int? // 所属剧集（空=独立单视频）
  series       Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  episodeNo    Int      @default(1) // 集号（独立视频恒为 1）
  episodeTitle String   @default("") // 分集标题（可空，空则显示"第 N 集"）
  description  String   @default("") // 剧情简介：独立视频输出到聚合站的 vod_blurb/vod_content

  @@unique([seriesId, episodeNo])
  @@index([order])
}
